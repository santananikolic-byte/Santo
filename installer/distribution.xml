<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>AutoVocal</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.autovocal.autovocal.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.autovocal.autovocal.pkg" visible="false">
        <pkg-ref id="com.autovocal.autovocal.pkg"/>
    </choice>
    <pkg-ref id="com.autovocal.autovocal.pkg" version="0" onConclusion="none">AutoVocal-core.pkg</pkg-ref>
</installer-gui-script>
