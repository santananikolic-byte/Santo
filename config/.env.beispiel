# Jarvis - Einstellungen
# ----------------------
# Diese Datei ist nur eine Vorlage. Die Ersteinrichtung legt die echte Datei
# config/.env selbst an - du musst hier nichts von Hand eintragen.
# Wer will, kann sie kopieren: cp config/.env.beispiel config/.env

# --- Das Einzige, was wirklich nötig ist ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Wer du bist ---
NUTZER_NAME=Chef
FIRMA=Gebäudereinigung
WETTER_ORT=Wien
STANDARD_MWST=20
STEUER_RUECKLAGE=30

# --- Wann Jarvis sich von selbst meldet ---
BRIEFING_MORGENS=06:45
BRIEFING_ABENDS=19:30

# --- Stimme (alles optional, die macOS-Stimme reicht und kostet nichts) ---
SPEECH_RATE=185
MACOS_STIMME=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
WHISPER_MODELL=base

# --- Stimmerkennung (optional) ---
STIMMPRUEFUNG_AN=nein
STIMM_SCHWELLE=0.75

# --- Telegram: der Weg für Freigaben unterwegs (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FREIGABE_TIMEOUT=120

# --- E-Mail (optional) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORT=
SMTP_ABSENDER=

# --- Telefon über Twilio (optional): anrufen und SMS ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMMER=
LANDESVORWAHL=+43

# Eigener Browser statt des mitgelieferten Chromium (optional)
BROWSER_PROGRAMM=

# --- Kalender über CalDAV (optional) ---
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORT=

# --- Supabase: nur Spiegelung, die Wahrheit bleibt lokal (optional) ---
SUPABASE_URL=
SUPABASE_KEY=

# Klangprofil der ElevenLabs-Stimme: ruhig, nah am Original, ohne Theatralik
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.10

# --- Einstellungen der Video-Funktionen (je Paket ein Block) ---
# [P1 Bühne] Anfang
# Wie lange die Zentrale eine gezeigte Ansicht hält (Sekunden)
ANZEIGE_DAUER=180
# [P1 Bühne] Ende
# [P2 Weltlage] Anfang
# [P2 Weltlage] Ende
# [P3 Telefon] Anfang
# --- Telefonassistent (optional): Jarvis ruft ein Restaurant an und reserviert einen Tisch ---
# Eine KI führt das Gespräch (Vapi). Sie sagt im ersten Satz, dass sie eine KI ist, nennt nur Name,
# Personenzahl, Zeit und - wenn eingetragen - eine Rückrufnummer, zahlt nichts und legt nach
# höchstens TELEFONAGENT_MAX_MINUTEN auf. Es wird mitgeschrieben, aber nicht aufgenommen.
# Kosten etwa 0,30 bis 0,60 Euro je Anruf. Jeder Anruf braucht deine Freigabe.
# Schlüssel: dashboard.vapi.ai -> API Keys -> Private Key
VAPI_SCHLUESSEL=
# Die Nummer, von der aus angerufen wird: In Vapi (Phone Numbers -> Import -> Twilio) einmal eine Nummer
# importieren - am besten eine eigene oder die eines Twilio-Unterkontos, denn der Import schaltet die
# Nummer auf Vapi um - und ihre ID hier eintragen. Jarvis gibt Twilio-Zugangsdaten NIE an Vapi weiter.
# In Twilio muss die Geo-Freigabe für Österreich/Deutschland an sein.
VAPI_TELEFON_ID=
# Konto in der EU-Region: https://api.eu.vapi.ai (Schlüssel und Adresse müssen zusammenpassen)
VAPI_BASIS=https://api.vapi.ai
VAPI_MODELL=claude-haiku-4-5-20251001
# Stimme (Azure). Geprüft: de-DE-KatjaNeural. Für Österreich: de-AT-IngridNeural oder de-AT-JonasNeural
VAPI_STIMME=de-DE-KatjaNeural
# Höchstdauer eines Gesprächs in Minuten (1 bis 10)
TELEFONAGENT_MAX_MINUTEN=4
# Diese Nummer nennt der Assistent, wenn das Restaurant danach fragt. Leer: Er sagt, dass du dich meldest.
TELEFONAGENT_RUECKRUF=
# Anbieter: vapi oder retell. Nur Retell zeigt die Mitschrift live (ungeprüft gegen das echte Retell).
TELEFONAGENT_ANBIETER=vapi
# Retell (nur bei TELEFONAGENT_ANBIETER=retell). Den Agenten einmal im Retell-Dashboard anlegen:
# Sprache Deutsch, Begrüßung {{erster_satz}}, Prompt {{auftrag}}, Höchstdauer wie oben, nichts
# aufnehmen oder speichern (sonst stimmt "nicht aufgenommen" im ersten Satz nicht). Optional unter
# Post-Call Analysis die Felder reserviert (Ja/Nein), datum, uhrzeit, personen, gegenvorschlag;
# ohne sie liest Jarvis das Ergebnis selbst aus der Mitschrift.
RETELL_SCHLUESSEL=
RETELL_AGENT_ID=
# Die Retell-Nummer, von der angerufen wird (international, +43...)
RETELL_NUMMER=
# [P3 Telefon] Ende
# [P4 Büro] Anfang
# Kalender: Name des Kalenders unterhalb von CALDAV_URL (oder gleich die ganze Adresse des Kalenders)
CALDAV_KALENDER=
# Zeitzone des Kalenders (Namen der Zeitzonen-Datenbank wie Europe/Vienna, Europe/Berlin, Europe/Zurich)
CALDAV_ZEITZONE=Europe/Vienna
# [P4 Büro] Ende
# [P5 Sicht] Anfang
# [P5 Sicht] Ende
# [P6 Stimme] Anfang
# [P6 Stimme] Ende
# [P7 Start] Anfang
# Für welche Plattformen die Inhalte-Planung Beiträge schreibt (kommagetrennt)
INHALTE_PLATTFORMEN=instagram,facebook,google
# Beim Hochfahren begrüßt Jarvis mit dem Tag (einmal je Tag): ja oder nein
BEGRUESSUNG_AN=ja
# Ordner der Kurzbefehle-App, aus dem Jarvis Kurzbefehle ausführt (Licht, Szenen, Fokus)
KURZBEFEHL_ORDNER=Jarvis
# Bildschirm für die Zentrale: 0 = Hauptbildschirm, 1 = der zweite
ANZEIGE_BILDSCHIRM=1
# [P7 Start] Ende
